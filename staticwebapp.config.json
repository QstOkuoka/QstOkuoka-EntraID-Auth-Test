{
  "routes": [
    { "route": "/admin", "allowedRoles": ["Admin"] },
    { "route": "/user",  "allowedRoles": ["authenticated"] },
    { "route": "/*",     "allowedRoles": ["authenticated"] },
    { "route": "/login",  "redirect": "/.auth/login/aad" },
    { "route": "/logout", "redirect": "/.auth/logout" }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [ "/api/*", "/.auth/*" ]   // ← ★ここが重要
  }
}
